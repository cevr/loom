{
  "name": "@cvr/loom",
  "version": "0.0.0",
  "private": true,
  "description": "An OTP-inspired kernel for coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cevr/loom.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@cvr/loom-daemon",
    "dev:pi": "pi --extension packages/pi-extension/src/index.ts",
    "probe:herdr-live": "bun packages/plugin-herdr/probes/live.ts",
    "probe:cell-evaluate": "bun packages/platform-bun/probes/evaluate-live-cell.ts",
    "probe:process-register": "bun packages/platform-bun/probes/register-live-process.ts",
    "probe:process-reconcile": "bun packages/platform-bun/probes/reconcile-live-process.ts",
    "prototype:job-pipeline": "bun apps/daemon/prototypes/job-pipeline/main.ts",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build": "turbo run build",
    "test": "turbo run test",
    "gate": "concurrently -n type,style,build -c blue,yellow,cyan \"bun run typecheck\" \"bun run lint && bun run fmt:check\" \"bun run build\" && bun run test",
    "prepare": "lefthook install && effect-tsgo patch"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.24.3",
    "@types/bun": "latest",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "concurrently": "10.0.4",
    "effect": "catalog:",
    "effect-bun-test": "0.3.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-plugin-effect": "0.6.0",
    "turbo": "2.10.9",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.0-canary.1",
  "catalog": {
    "effect": "4.0.0-beta.106",
    "@effect/platform-bun": "4.0.0-beta.106",
    "@effect/platform-node-shared": "4.0.0-beta.106",
    "@effect/sql-sqlite-bun": "4.0.0-beta.106",
    "@earendil-works/pi-coding-agent": "0.84.1"
  }
}
